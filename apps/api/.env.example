PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password123@localhost:5433/velapal_v6?schema=public"

# Web Origin for CORS & Origin Verification
WEB_ORIGIN="http://localhost:3000"

# Directional Internal Service Auth Tokens (V6.1 Frozen Contract)
WORKER_TO_AI_SECRET="velapal-worker-to-ai-secret-v61"
AI_TO_EXPRESS_SECRET="velapal-ai-to-express-secret-v61"
MANIFEST_HMAC_SECRET="velapal-manifest-hmac-secret-v61"
AI_SERVICE_URL="http://localhost:8000"
API_INTERNAL_BASE_URL="http://localhost:4000"

# PayPal Sandbox Credentials
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_SANDBOX_WEBHOOK_ID"
PAYPAL_MERCHANT_ID="merch_vela_01"
# Required for PayPal seller onboarding and multiparty subscription plans.
# PayPal must approve this REST app for Partner Referrals / multiparty features.
PAYPAL_PARTNER_MERCHANT_ID="YOUR_PAYPAL_PARTNER_MERCHANT_ID"
PAYPAL_PARTNER_ATTRIBUTION_ID="YOUR_PAYPAL_BN_CODE"
PAYPAL_ONBOARDING_RETURN_URL="http://localhost:3000/workspace/settings"

# Private S3-Compatible Object Storage (MinIO / R2 / AWS S3)
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_BUCKET="velapal-private"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
